{
  "name": "studio-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Operator — cockpit for a semi-autonomous, AI-native creative service firm (Astra orchestration + Higgsfield production layer).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reset-data": "rm -rf data/platform.json data/workspaces",
    "mcp": "tsx server/mcp-stdio.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
