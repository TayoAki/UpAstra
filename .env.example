# Studio Operator configuration. Every key is optional in development:
# without them the app runs on free simulators.

PORT=8787
NODE_ENV=development

# --- Platform -----------------------------------------------------------------
# Postgres (Railway: reference ${{Postgres.DATABASE_URL}}). Unset = JSON files in ./data
DATABASE_URL=
# Signs session cookies. REQUIRED in production (any long random string).
SESSION_SECRET=
# Public URL of the app (used for OpenRouter attribution and invite links)
APP_URL=http://localhost:5173
# Set to false to make sign-up invite-only
ALLOW_SIGNUP=true
# Upper bound any workspace can set for per-job spend (USD)
MAX_SPEND_PER_JOB_CEILING=100

# --- Built-in AI: OpenRouter (default) or any OpenAI-compatible endpoint ---------
OPENROUTER_API_KEY=
# Model per role; unset roles fall back to ASTRA_MODEL, then "openrouter/auto"
ASTRA_MODEL=
COPY_FAST_MODEL=
COPY_PRO_MODEL=
COPY_EDIT_MODEL=
PROPOSAL_MODEL=
# Alternative to OpenRouter:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Higgsfield (images / video) ------------------------------------------------
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# --- Job Radar: Apify -----------------------------------------------------------
APIFY_TOKEN=
# Default actor per source ("username~actor-name"); searches can override
APIFY_ACTOR_UPWORK=
APIFY_ACTOR_FIVERR=
APIFY_ACTOR_LINKEDIN=
APIFY_ACTOR_CONTRA=
RADAR_MAX_RUNS_PER_DAY=24
# Set to 0 to disable scheduled searches
RADAR_SCHEDULER=1

# --- MCP stdio client (npm run mcp) -----------------------------------------------
STUDIO_API_URL=http://localhost:8787
STUDIO_API_TOKEN=

# --- Client portal ---------------------------------------------------------------
# Optional wildcard base: <slug>.PORTAL_BASE_DOMAIN serves each studio's portal
# (point *.portal.yourapp.com at the app). Custom domains work without it.
PORTAL_BASE_DOMAIN=
PORTAL_MAX_REQUESTS_PER_HOUR=10
MAX_UPLOAD_MB=15
# File storage for client uploads: any S3-compatible bucket (Railway bucket,
# AWS S3, Cloudflare R2). Unset = local disk under DATA_DIR/uploads.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
