# Server port for the API (the Vite dev server proxies /api to it)
PORT=8787

# --- Astra (orchestrator) -------------------------------------------------
# OpenAI-compatible chat completions endpoint. Leave OPENAI_API_KEY empty to run
# the built-in deterministic orchestrator ("simulated" mode).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ASTRA_MODEL=astra

# --- Higgsfield (production layer) ----------------------------------------
# Leave HIGGSFIELD_API_KEY empty to use the simulated production layer, which
# renders placeholder outputs and charges catalog list prices.
# The key never leaves the server.
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
