# Server port for the API (the Vite dev server proxies /api to it)
PORT=8787

# --- Astra (orchestrator) -------------------------------------------------
# OpenAI-compatible chat completions endpoint. Leave OPENAI_API_KEY empty to run
# the built-in deterministic orchestrator ("simulated" mode).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ASTRA_MODEL=astra

# --- Higgsfield (production layer) ----------------------------------------
# Leave HIGGSFIELD_API_KEY empty to use the simulated production layer, which
# renders placeholder outputs and charges catalog list prices.
# The key never leaves the server.
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# --- Copywriting models (text lanes) ---------------------------------------
# Each copy tier maps to a model on the OpenAI-compatible endpoint above.
# Unset tiers fall back to ASTRA_MODEL.
COPY_FAST_MODEL=
COPY_PRO_MODEL=
COPY_EDIT_MODEL=

# --- MCP ---------------------------------------------------------------------
# stdio (Claude Desktop / Claude Code): `npm run mcp` talks to this API.
STUDIO_API_URL=http://localhost:8787
# Set to serve MCP over HTTP at /mcp for remote agents (Bearer token required).
MCP_TOKEN=
