# Clip Operator
PORT=8788
APP_URL=http://localhost:8788
# Required in production: signs session cookies
SESSION_SECRET=
# Postgres (production). Without it, data is kept as JSON files in DATA_DIR (default ./data)
DATABASE_URL=
# Set to "false" to close sign-ups
ALLOW_SIGNUP=true

# --- AI (OpenRouter, or any OpenAI-compatible endpoint via OPENAI_API_KEY + OPENAI_BASE_URL)
OPENROUTER_API_KEY=
# Reads briefs (cheap and fast)
EXTRACT_MODEL=anthropic/claude-haiku-5.5
# Writes clip plans
SCRIPT_MODEL=anthropic/claude-sonnet-5.5
# AI calls allowed per workspace per day
AI_DAILY_LIMIT=150

# --- Video rendering (phase 2: OpenShorts + Remotion worker)
RENDER_SERVICE_URL=
