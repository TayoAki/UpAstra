# Clip Operator
PORT=8788
APP_URL=http://localhost:8788
# Required in production: signs session cookies
SESSION_SECRET=
# Postgres (production). Without it, data is kept as JSON files in DATA_DIR (default ./data)
DATABASE_URL=
# Set to "false" to close sign-ups
ALLOW_SIGNUP=true

# --- AI (OpenRouter, or any OpenAI-compatible endpoint via OPENAI_API_KEY + OPENAI_BASE_URL)
OPENROUTER_API_KEY=
# Reads briefs (cheap and fast)
EXTRACT_MODEL=anthropic/claude-haiku-5.5
# Writes clip plans
SCRIPT_MODEL=anthropic/claude-sonnet-5.5
# AI calls allowed per workspace per day
AI_DAILY_LIMIT=150

# Watches footage for moments (needs video input — Gemini via OpenRouter)
MOMENT_MODEL=google/gemini-3.5-flash-lite
# Reads voiceovers aloud (audio output via OpenRouter)
VOICE_MODEL=openai/gpt-audio-mini

# --- Rendering (ffmpeg must be installed; the Docker image includes it)
# Renders at once (each uses ~1 CPU while encoding)
RENDER_CONCURRENCY=1
# Largest footage file fetched or uploaded
MAX_FOOTAGE_MB=4096
# Storage for footage copies and rendered videos: any S3-compatible bucket.
# Unset = local disk under DATA_DIR/videos. Everything goes under S3_PREFIX.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=clip-operator/
